{
  "name": "dsh-plugins-manager",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: a GUI + dsh_plugin_manage tool to control your custom DSH plugins — list, install, update, uninstall, enable and disable (from npm).",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.cs.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Michal Ožuch",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "manager",
    "npm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meliodascz89/dsh-plugins-manager.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2"
  },
  "dependencies": {}
}
